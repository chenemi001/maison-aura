# -----------------------------------------------------------------------------
# Maison Aura — environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# Every integration is optional: without keys the storefront runs on the
# built-in 50,000-product demo catalogue, customer accounts use the built-in
# auth provider, and checkout shows a clear "not enabled" notice instead of
# pretending to take payment.
# -----------------------------------------------------------------------------

# Public base URL, used for canonical URLs, sitemaps and Stripe redirects.
# On Vercel this falls back to the production / preview URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentication ------------------------------------------------------------
# Without Supabase, a built-in provider stores accounts in .data/users.json and
# signs session cookies with this secret (auto-generated locally if unset).
# Set a long random value in any shared/production environment:
#   openssl rand -base64 48
AUTH_SECRET=

# --- Supabase (auth + database) ----------------------------------------------
# Project Settings → API. The publishable (anon) key is safe for the browser;
# Row Level Security protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (service role) key — used for order writes from the
# checkout and verified webhooks. NEVER expose this to the browser.
SUPABASE_SECRET_KEY=

# Serve products from Supabase instead of the in-memory demo catalogue.
# Run `npm run db:seed` first. Values: "demo" (default) | "supabase"
CATALOG_SOURCE=demo

# --- Stripe (payments) -------------------------------------------------------
# Use test-mode keys (sk_test_…) for development. Dashboard → Developers.
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/payment (whsec_…). For local development:
#   stripe listen --forward-to localhost:3000/api/webhooks/payment
STRIPE_WEBHOOK_SECRET=

# --- On-demand revalidation --------------------------------------------------
# Shared secret for POST /api/revalidate (generate with `openssl rand -hex 32`).
REVALIDATE_SECRET=
